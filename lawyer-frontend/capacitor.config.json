{
  "appId": "com.jurisbot.lawyer",
  "appName": "JurisBot PRO",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["localhost:5000", "*.jurisbot.com"]
  },
  "android": {
    "backgroundColor": "#0f111a",
    "allowMixedContent": true
  },
  "ios": {
    "backgroundColor": "#0f111a",
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f111a",
      "showSpinner": false,
      "spinnerColor": "#c9a84c"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f111a"
    }
  }
}
