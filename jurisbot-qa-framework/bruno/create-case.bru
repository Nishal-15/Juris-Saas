meta {
  name: Create Case
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cases
  body: json
  auth: bearer
}

auth:bearer {
  token: {{citizenToken}}
}

body:json {
  {
    "title": "Dispute over unreturned deposit",
    "description": "My landlord is refusing to return my deposit of 50k",
    "category": "Property",
    "legalType": "Civil Law",
    "incidentDate": "2024-05-12",
    "urgency": "Normal",
    "mediationRequested": true
  }
}

assert {
  res.status: eq 201
  res.body.status: eq Mediation Requested
}
