meta {
  name: Admin Update Case Status
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/admin/cases/{{testCaseId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "Mediation Active",
    "assignedMediator": "test-mediator-id"
  }
}

assert {
  res.status: eq 200
  res.body.case.status: eq Mediation Active
}
