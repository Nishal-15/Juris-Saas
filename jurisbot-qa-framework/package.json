{
  "name": "jurisbot-qa-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade automated testing framework for JurisBot",
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "bruno run bruno/ --env production",
    "test:unit:frontend": "vitest run",
    "test:unit:backend": "jest",
    "test:security": "node owasp/run-zap.js",
    "test:perf": "node lighthouse/run-lighthouse.js",
    "test:load": "k6 run k6/load-test.js",
    "test:ai": "playwright test tests/ai_validation",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "vitest": "^1.2.0",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "husky": "^9.0.7",
    "lint-staged": "^15.2.0",
    "axe-playwright": "^2.0.1",
    "dotenv": "^16.4.1",
    "@types/k6": "^0.48.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
