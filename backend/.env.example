# 🗄️ Database
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/jurisbot?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your_jwt_secret_here

# 🤖 AI Service Config
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=jurisbot-index
AI_SERVICE_URL=http://127.0.0.1:8088
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8088/chat
LLM_MODEL=mistral
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 🌐 Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-production-url.com

# 📧 Resend Email Config
RESEND_API_KEY=your_resend_api_key_here

# 💳 Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret  

# ⚖️ Legal Data & Config
INDIAN_KANOON_API_KEY=your_indian_kanoon_key_here
DEMO_MODE=false

# 🔍 Real-Time Legal Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# 🎥 AI Avatar Configuration (HeyGen)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_heygen_avatar_id_here

# 📱 WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 📹 Daily.co (Frictionless Video Calling)
DAILY_API_KEY=your_daily_api_key_here
